module(
    name = "hermes",
    version = "",
    bazel_compatibility = [">=8.0.0"],
)

# Required when consumers load the public targets and their code generators.
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "package_metadata", version = "0.0.13")

hermes = use_extension("//:repositories.bzl", "hermes")
use_repo(hermes, "hermes_src")

# Development toolchains, tests, packaging, and formatting.
bazel_dep(name = "llvm", version = "0.8.25", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.3.0", dev_dependency = True)
bazel_dep(name = "with_cfg.bzl", version = "1.0.1", dev_dependency = True)
bazel_dep(name = "aspect_rules_js", version = "3.5.2", dev_dependency = True)
bazel_dep(name = "rules_nodejs", version = "6.7.7", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(python_version = "3.12.7")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "24.14.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(pnpm_version = "10.4.1")
use_repo(pnpm, "pnpm")

release_npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
release_npm.npm_translate_lock(
    name = "release_npm",
    data = ["//tools/release:pnpm-workspace.yaml"],
    pnpm_lock = "//tools/release:pnpm-lock.yaml",
)
use_repo(release_npm, "release_npm")
