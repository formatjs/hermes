load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

cc_test(
    name = "runtime_test",
    srcs = ["@hermes//tests:runtime_test.cpp"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = ["@hermes//:hermes_vm"],
)

pkg_files(
    name = "smoke_files",
    testonly = True,
    srcs = [
        ":runtime_test",
        "@hermes//:hermesc",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        ":runtime_test": "runtime_test",
        "@hermes//:hermesc": "hermesc",
    },
)

pkg_tar(
    name = "smoke_bundle",
    testonly = True,
    srcs = [":smoke_files"],
    out = "smoke.tar.gz",
    extension = "tar.gz",
)
