module(name = "hermes_smoke")

bazel_dep(name = "hermes")
local_path_override(
    module_name = "hermes",
    path = "../..",
)

# Test helpers and toolchain selection belong to this consumer root only.
bazel_dep(name = "llvm", version = "0.8.25", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.27", dev_dependency = True)
bazel_dep(name = "rules_python", version = "2.4.5", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(python_version = "3.12.7")
