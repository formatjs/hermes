load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel:dist.bzl", "macos_arm64_dist")

pkg_files(
    name = "smoke_files",
    testonly = True,
    srcs = [
        "//:hermesc",
        "//tests:runtime_test",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "//:hermesc": "hermesc",
        "//tests:runtime_test": "runtime_test",
    },
    tags = ["manual"],
)

pkg_tar(
    name = "smoke_bundle",
    testonly = True,
    srcs = [":smoke_files"],
    out = "smoke.tar.gz",
    extension = "tar.gz",
    tags = ["manual"],
)

macos_arm64_dist(
    name = "smoke_macos_arm64",
    testonly = True,
    srcs = [":smoke_bundle"],
    tags = ["manual"],
)
