load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_files(
    name = "smoke_files",
    testonly = True,
    srcs = [
        "//:hermesc",
        "//tests:runtime_test",
    ],
    attributes = pkg_attributes(mode = "0755"),
    renames = {
        "//:hermesc": "hermesc",
        "//tests:runtime_test": "runtime_test",
    },
)

pkg_tar(
    name = "smoke_bundle",
    testonly = True,
    srcs = [":smoke_files"],
    out = "smoke.tar.gz",
    extension = "tar.gz",
)
